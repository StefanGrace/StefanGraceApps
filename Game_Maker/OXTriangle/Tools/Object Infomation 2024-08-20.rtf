\par \b0 execute code:
\par 
\par if (y == teleport_y) script_execute(J_Detonate)
\par 
\par \b Alarm Event for alarm 2:
\par \b0 execute code:
\par 
\par global.boulder_sound_playing = false
\par 
\par \b Alarm Event for alarm 3:
\par \b0 execute code:
\par 
\par left_pressed = false;
\par right_pressed = false;
\par 
\par 
\par \b  Step Event:
\par \b0 execute script Time_Bomb_Script with arguments (0,0,0,0,0)
\par execute code:
\par 
\par if (keyboard_check(vk_left) || keyboard_check(ord("A")) || joystick_xpos(0) < -0.1 || Tablet_UI_Left_Button.clicked) 
\par \{
\par     left_pressed = true;
\par     alarm[3] = KEY_DELAY;
\par \}
\par else if (keyboard_check(vk_right) || keyboard_check(ord("D")) || joystick_xpos(0) > 0.1 || Tablet_UI_Right_Button.clicked)
\par \{
\par     right_pressed = true;
\par     alarm[3] = KEY_DELAY;
\par \}
\par 
\par \b End Step Event:
\par \b0 execute script Boulder_Fall with arguments (0,0,0,0,0)
\par 
\par \b Collision Event with object Rock:
\par \b0 if rock_tunnle is larger than 0
\par       for other object: change the instance into object Yellow, not performing events
\par 
\par \b Collision Event with object Dimond:
\par \b0 if dimond_tunnle is larger than 0
\par       for other object: change the instance into object Yellow, not performing events
\par 
\par \b Collision Event with object Concreet:
\par \b0 if concreet_tunnle is larger than 0
\par       for other object: change the instance into object Yellow, not performing events
\par 
\par \b Mouse Event for Left Button:
\par \b0 execute script Time_Bomb_Set with arguments (0,0,0,0,0)
\par 
\par \b Mouse Event for Right Button:
\par \b0 execute code:
\par 
\par if (global.cheats) instance_destroy()
\par 
\par \b Draw Event:
\par \b0 execute code:
\par 
\par if (time_bomb>0) 
\par \{
\par     draw_sprite(Time_Bomb_Sprite,countdown,x,y)
\par \}
\par else if (j_bomb>0)
\par \{
\par     draw_sprite(J_Bomb_Sprite,0,x,y)
\par \}
\par else if (nuclear>0)
\par \{
\par     draw_sprite(Nuclear_Bomb_Sprite,0,x,y)
\par \}
\par else if (concreet_tunnle>0)
\par \{
\par     draw_sprite(Concreet_Bomb_Sprite,0,x,y)
\par \}
\par else if (dimond_tunnle>0)
\par \{
\par     draw_sprite(Dimond_Bomb_Sprite,0,x,y)
\par \}
\par else if (rock_tunnle>0)
\par \{
\par     draw_sprite(Tunnling_Bomb_Sprite,0,x,y)
\par \}
\par else 
\par \{
\par     draw_sprite(Boulder_Sprite,0,x,y)
\par \}
