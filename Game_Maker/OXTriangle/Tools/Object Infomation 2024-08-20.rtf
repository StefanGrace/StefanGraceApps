\par \b\fs24 Information about object: R_Arrow_Mask
\par \b0\fs16 
\par Sprite: Colission_Mask
\par Solid: false
\par Visible: true
\par Depth: 50
\par Persistent: false
\par Parent: <no parent>
\par Mask: <same as sprite>
\par 
\par \b Alarm Event for alarm 0:
\par \b0 execute code:
\par 
\par with(R_Arrow) instance_destroy()
\par 
\par \b  Step Event:
\par \b0 execute code:
\par 
\par // Stefan Grace
\par // Created: 2018-04-19
\par // Modified: 2018-04-19
\par 
\par if (x != last_x or y != last_y)
\par \{
\par     if (instance_number(Go_Number_Black)>0)
\par     \{
\par         if (place_meeting(x,y,Red_Stuned_Y))
\par         \{
\par             with(R_Arrow) instance_destroy()
\par             exit
\par         \}
\par         with(all)
\par         \{
\par             if (player == 1)
\par             \{
\par                 if (character_id != 15 and character_id != 13)
\par                 \{
\par                     if (place_meeting(x,y,other))
\par                     \{
\par                         other.alarm[0] = 1
\par                         with(R_Arrow) 
\par                         \{
\par                             hspeed = 0
\par                             vspeed = 0
\par                         \}
\par                         instance_destroy()
\par                     \}
\par                 \}
\par             \}
\par         \}
\par     \}
