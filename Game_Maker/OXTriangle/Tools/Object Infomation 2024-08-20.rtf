\par \}
\par 
\par if (place_meeting(x,y,Dimond_Bomb_Object))
\par \{
\par     sprite_index = Dimond_Bomb_Sprite
\par     rock_tunnle = 1
\par     dimond_tunnle = 1
\par \}
\par 
\par if (place_meeting(x,y,Concreet_Bomb_Object))
\par \{
\par     sprite_index = Concreet_Bomb_Sprite
\par     rock_tunnle = 1
\par     dimond_tunnle = 1
\par     concreet_tunnle = 1
\par \}
\par 
\par if (place_meeting(x,y,Nuclear_Bomb_Object))
\par \{
\par     sprite_index = Nuclear_Bomb_Sprite
