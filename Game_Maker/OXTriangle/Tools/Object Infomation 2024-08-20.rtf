\par draw_set_halign(fa_center)
\par draw_set_valign(fa_middle)
\par draw_set_font(NWH_Font)
\par draw_text_color(x+17,y+17,gate_id,c_red,c_red,c_red,c_red,1)
\par if (gate_type == 0 or gate_type == 2) draw_text_color(x+17,y+17+(grid_size*((2*gate_size)+1)),gate_id,c_red,c_red,c_red,c_red,1)
\par if (gate_type == 1 or gate_type == 3) draw_text_color(x+17+(grid_size*((2*gate_size)+1)),y+17,gate_id,c_red,c_red,c_red,c_red,1)
\par draw_set_halign(0)
\par draw_set_valign(0)
\par var i;
\par if (gate_open)
\par \{
\par     for (i=grid_size; i<=gate_size*grid_size; i+=grid_size)
\par     \{
\par         if (gate_type==0) 
\par         \{
\par             draw_sprite(Gate_Horizontal_Sprite,0,x-i,y+grid_size)
\par             draw_sprite(Gate_Horizontal_Sprite,0,x-i,y+grid_size+(grid_size*2*gate_size))
\par         \}
\par         else if (gate_type==1) 
\par         \{
\par             draw_sprite(Gate_Vertical_Sprite,0,x+grid_size,y-i)
\par             draw_sprite(Gate_Vertical_Sprite,0,x+grid_size+(grid_size*2*gate_size),y-i)
\par         \}
\par         else if (gate_type==2) 
\par         \{
\par             draw_sprite(Gate_Horizontal_Sprite,0,x+i,y+grid_size)
\par             draw_sprite(Gate_Horizontal_Sprite,0,x+i,y+grid_size+(grid_size*2*gate_size))
\par         \}
\par         else if (gate_type==3) 
\par         \{
\par             draw_sprite(Gate_Vertical_Sprite,0,x+grid_size,y+i)
\par             draw_sprite(Gate_Vertical_Sprite,0,x+grid_size+(grid_size*2*gate_size),y+i)
\par         \}
\par     \}
\par \}
\par else
\par \{
\par     for (i=grid_size; i<=gate_size*2*grid_size; i+=grid_size)
\par     \{
\par         if (gate_type==0) draw_sprite(Gate_Vertical_Sprite,0,x,y+i)
\par         if (gate_type==1) draw_sprite(Gate_Horizontal_Sprite,0,x+i,y)
\par         if (gate_type==2) draw_sprite(Gate_Vertical_Sprite,0,x+grid_size,y+i)
\par         if (gate_type==3) draw_sprite(Gate_Horizontal_Sprite,0,x+i,y+grid_size)
\par     \}
\par \}
