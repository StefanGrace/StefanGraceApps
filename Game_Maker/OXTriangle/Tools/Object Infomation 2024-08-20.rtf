\par \}
\par 
\par if (place_meeting(x,y,J_Bomb_Object))
\par \{
\par     sprite_index = J_Bomb_Sprite
\par     j_bomb = 1
\par \}
\par 
\par if (place_meeting(x,y,Time_Bomb_Object))
\par \{
