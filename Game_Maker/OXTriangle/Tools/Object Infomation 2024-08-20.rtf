\par 
\par if (instance_number(Tablet_UI) > 0)
\par \{
\par     draw_set_halign(fa_center)
\par     draw_set_valign(fa_center)
\par     draw_set_font(Player_Select_Font)
\par     
\par     var sprite;
\par     if (instance_number(Red_Blue) > 0)
\par     \{
\par         sprite = Player_One_Sprite
\par         draw_set_color(c_red)
\par     \}
\par     else if (instance_number(Black_Blue) > 0)
\par     \{
\par         sprite = Player_Two_Sprite
\par         draw_set_color(c_black)
\par     \}
\par     
\par     // Shoot
\par     if (instance_number(Red_Blue_R) + instance_number(Black_Blue_R) > 0)
\par     \{
\par         if (global.tablet_function_button_active)
\par         \{
\par             draw_rectangle(x, y, x + sprite_width, y + sprite_height, false)
\par             draw_set_color(c_white)
\par         \}
\par         else 
\par         \{
\par             draw_sprite(sprite, 0, x, y)
\par         \}
\par         
\par         draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_shoot)   
\par     \}
\par     
\par     // Catapult
\par     else if (instance_number(Red_Blue_C) + instance_number(Black_Blue_C) + instance_number(Red_Blue_N) + instance_number(Black_Blue_N) > 0)
\par     \{
\par          if (global.tablet_function_button_active)
\par         \{
\par             draw_rectangle(x, y, x + sprite_width, y + sprite_height, false)
\par             draw_set_color(c_white)
\par         \}
\par         else 
\par         \{
\par             draw_sprite(sprite, 0, x, y)
\par         \}
\par         draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_catapult)   
\par     \}
\par     
\par     // Long
\par     else if (instance_number(Red_Blue_L) + instance_number(Black_Blue_L) > 0)
\par     \{
\par          if (global.tablet_function_button_active)
\par         \{
\par             draw_rectangle(x, y, x + sprite_width, y + sprite_height, false)
\par             draw_set_color(c_white)
\par         \}
\par         else 
\par         \{
\par             draw_sprite(sprite, 0, x, y)
\par         \}
\par         draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_long)   
\par     \}
\par     
\par     // Detonate
\par     else if (instance_number(Red_Blue_J) + instance_number(Red_Blue_M) + instance_number(Red_Blue_Z) + instance_number(Red_Blue_T) +
\par     instance_number(Black_Blue_J) + instance_number(Black_Blue_M) + instance_number(Black_Blue_Z) + instance_number(Black_Blue_T) > 0)
\par     \{
\par         draw_sprite(sprite, 0, x, y)
\par         draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_detonate)
\par     \}
\par 
\par     // Cast
\par     else if (instance_number(Red_Blue_W) + instance_number(Red_Blue_Dollar_Sign) +
\par     instance_number(Black_Blue_W) + instance_number(Black_Blue_Dollar_Sign) > 0)
\par     \{
\par         
\par         draw_sprite(sprite, 0, x, y)
\par         draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_cast)
\par     \}
\par     else if (instance_number(Red_Blue_G) + instance_number(Black_Blue_G) > 0)
\par     \{
\par         var big_w;
\par         with (Red_Blue)
\par         \{
\par             if (g_type == 3) big_w = true;
\par         \}
\par         with (Black_Blue)
\par         \{
\par             if (g_type == 3) big_w = true;
\par         \}
\par         if (big_w)
\par         \{
\par             draw_sprite(sprite, 0, x, y)
\par             draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_cast)
\par         \}
\par     \}
\par     
\par     // Swap
\par     else if (instance_number(Red_Blue_At) + instance_number(Black_Blue_At) > 0)
\par     \{
\par         draw_sprite(sprite, 0, x, y)
\par         draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_swap)
\par     \}
\par 
\par     // Spawn
\par     else if (instance_number(Red_Blue_Q) + instance_number(Black_Blue_Q) > 0)
\par     \{
\par         draw_sprite(sprite, 0, x, y)
\par         draw_text(x+(sprite_width/2),y+(sprite_height/2),global.text_spawn)
\par     \}
\par     
\par     draw_set_halign(0)
\par     draw_set_valign(0)
\par \}
