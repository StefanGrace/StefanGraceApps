\par 
\par \b  Step Event:
\par \b0 execute code:
\par 
\par if (global.joy_press)
\par \{
\par     if (joystick_direction(1) == 101) global.joy_press = false
\par \}
\par 
\par if (!global.onlevel || global.levelnumber == 16 || global.levelnumber == 24 || instance_number(Level_Cover) > 0 || instance_number(Player_Winz) > 0)
\par \{
\par     if (abs(joystick_xpos(0) > 0.1) || abs(joystick_ypos(0) > 0.1))
\par     \{
\par         if (instance_number(Hand) == 0) instance_create(room_width / 2, room_height / 2, Hand)
\par     \}
\par \}
\par else
\par \{
\par     if (instance_number(Hand) > 0)
\par     \{
\par         with (Hand) instance_destroy()
\par     \}
\par \}
\par 
\par if (joystick_check_button(joy_id, 12))
\par \{
\par     if (!joy_btn_pressed[12])
\par     \{
\par         joy_btn_pressed[12] = true;
\par         Take_Screen_Shot()
\par     \}
\par \}
\par else
\par \{
\par     joy_btn_pressed[12] = false;
\par \}
\par 
\par 
\par 
