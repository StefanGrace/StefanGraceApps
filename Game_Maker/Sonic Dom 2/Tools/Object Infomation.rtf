\par \b\fs24 Information about object: object_Dr_Robonic
\par \b0\fs16 
\par Sprite: sprite_dr_robonic
\par Solid: false
\par Visible: true
\par Depth: 0
\par Persistent: false
\par Parent: <no parent>
\par Mask: <same as sprite>
\par 
\par \b  Step Event:
\par \b0 execute code:
\par 
\par if (object_Sonic.zone == 2) \{
\par     if (y == ystart) \{
\par         vspeed = -4;
\par     \} else if (y == ystart - 720) \{
\par         vspeed = 4;
\par     \}
\par \} else if (object_Sonic.zone == 3) \{
\par     if (clock mod 120 == 0) \{
\par          instance_create(6208, 1152, object_Pinball);
\par          instance_create(6720, 1152, object_Pinball);
\par     \}
\par     clock += 1;
\par \}
\par 
\par if (object_Sonic.boss_hit > 7) \{
\par     object_Sonic.boss = false;
\par     object_Sonic.boss_hit = 0;
\par     object_Sonic.boss_hit_time = 0;
\par     hspeed = 0;
\par     sound_play(sound_mob_kill);
\par     if (object_Sonic.zone == 1) \{
\par         object_Sonic.bottom_bound = room_height;
\par         object_Sonic.top_bound = 0;
\par         object_Sonic.boss_done_extra_terrestrial = true;
\par         with(object_Spike_Ball) \{instance_destroy();\}
\par     \} else if (object_Sonic.zone == 2) \{
\par         object_Sonic.right_bound = room_width;
\par         object_Sonic.bottom_bound = room_height;
\par         object_Sonic.top_bound = 0;
\par         object_Sonic.boss_done_martian = true;
\par     \} else if (object_Sonic.zone == 3) \{
\par         object_Sonic.right_bound = room_width;
\par         object_Sonic.bottom_bound = room_height;
\par         object_Sonic.top_bound = 0;
\par         object_Sonic.boss_done_pinball = true;
\par         with (object_Gate_Horizontal) \{
\par             if (gate_id == 0) \{instance_destroy();\}
\par         \}
\par     \}
\par     instance_change(object_Exploding, true);
\par \}
\par 
\par \b Draw Event:
\par \b0 execute code:
\par 
\par if (object_Sonic.boss_hitting) \{
\par     draw_sprite(sprite_dr_robonic_hitting, 0, x, y);
\par \} else \{
\par     draw_sprite(sprite_dr_robonic, 0, x, y);
\par \}
\par 
\par if (object_Sonic.boss_hit > 0) \{
\par     if (object_Sonic.boss_hit < 2) \{
\par         draw_sprite(sprite_dr_robonic_hit1, 0, x, y);
\par     \} else if (object_Sonic.boss_hit < 3) \{
\par         draw_sprite(sprite_dr_robonic_hit2, 0, x, y);
\par     \} else if (object_Sonic.boss_hit < 4) \{
\par         draw_sprite(sprite_dr_robonic_hit3, 0, x, y);
\par     \} else if (object_Sonic.boss_hit < 5) \{
\par         draw_sprite(sprite_dr_robonic_hit4, 0, x, y);
\par     \} else if (object_Sonic.boss_hit < 6) \{
\par         draw_sprite(sprite_dr_robonic_hit5, 0, x, y);
\par     \} else if (object_Sonic.boss_hit < 7) \{
\par         draw_sprite(sprite_dr_robonic_hit6, 0, x, y);
\par     \} else \{
\par         draw_sprite(sprite_dr_robonic_hit7, 0, x, y);
\par     \} 
\par \}
\par ______________________________________________________
