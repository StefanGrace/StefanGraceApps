\par \b\fs24 Information about object: object_Start_Control
\par \b0\fs16 
\par Sprite: <no sprite>
\par Solid: false
\par Visible: true
\par Depth: 0
\par Persistent: false
\par Parent: <no parent>
\par Mask: <same as sprite>
\par 
\par \b Create Event:
\par \b0 execute code:
\par 
\par sound_play(sound_dom);
\par 
\par zones[1] = "Extra-Terrestrial";
\par zones[2] = "Martian";
\par zones[3] = "Pinball";
\par 
\par \b  Step Event:
\par \b0 execute code:
\par 
\par if (time == 0) \{alpha_dom = 1;\}
\par if (time > 2) \{
\par     if (alpha_dom > 0) \{
\par         alpha_dom -= 1 / 15;
\par     \} else if (alpha_credits < 1 && time < 4.5) \{
\par         alpha_credits += 1 / 15;
\par     \} else if (time > 4.5 && alpha_credits > 0) \{
\par         alpha_credits -= 1 / 15;
\par         if (!sound_isplaying(sound_welcome)) \{sound_play(sound_welcome);\}
\par     \} else if (time > 4.5 && alpha_credits <= 0 && alpha_welcome < 1) \{
\par         alpha_welcome += 1 / 15;
\par     \}
\par \}
\par time += 1 / 30;
\par if (keyboard_check(vk_enter)) \{
\par     if (level_select)\{
\par         global.act_select = act_select;
\par         global.zone_select = zone_select;
\par     \}
\par     room_goto_next();
\par \}
\par if (keyboard_check(ord("A")) || keyboard_check(ord("D")) || keyboard_check(vk_space)) \{
\par     level_select = true;
\par \}
\par 
\par if (keyboard_check(ord("R"))) \{game_restart();\}
\par 
\par \b Draw Event:
\par \b0 execute code:
\par 
\par if (!level_select) \{
\par     draw_sprite_ext(sprite_dom, 0, 0, 0, 1, 1, 0, c_white, alpha_dom);
\par     draw_set_halign(fa_center);
\par     draw_set_valign(fa_middle);
\par     draw_set_font(font_title);
\par     draw_text_color(room_width / 2, room_height /2, "Designed by Dominic Grace#Programmed by Stefan Grace", c_white, c_white, c_white, c_white, alpha_credits);
\par     draw_set_valign(0);
\par     draw_sprite_ext(sprite_welcome, 0, 0, 0, 1, 1, 0, c_white, alpha_welcome);
\par \} else \{
\par     draw_sprite(sprite_level_select, 0, 970, 190);
\par     draw_set_halign(fa_left);
\par     draw_set_font(font_display);
\par     draw_set_color(c_white);
\par     var i;
\par     for (i = 0; i < 3; i += 1) \{
\par         zone_colors[i] = c_white;
\par         zone_colors[zone_select] = c_yellow; 
\par         zone_text = " Zone";
\par         draw_text_color(200, 200 + (i * 50), zones[i + 1] + " Zone", zone_colors[i], zone_colors[i],  zone_colors[i],  zone_colors[i], 1);
\par         draw_text(550, 200 + (i * 50), "Act");
\par         for (j = 0; j < 2; j += 1) \{
\par             act_colors[j] = c_white;
\par             if (zone_select == i) \{act_colors[act_select] = c_yellow; \}
\par             draw_text_color(610 + (j * 20), 200 + (i * 50), j + 1, act_colors[j], act_colors[j],  act_colors[j],  act_colors[j], 1);
\par         \}
\par     \}
\par \}
\par 
\par \b Key Press Event for <Left> Key:
\par \b0 execute code:
\par 
\par if (act_select > 0) \{act_select -= 1;\}
\par 
\par \b Key Press Event for <Up> Key:
\par \b0 execute code:
\par 
\par if (zone_select > 0) \{zone_select -= 1;\}
\par 
\par \b Key Press Event for <Right> Key:
\par \b0 execute code:
\par 
\par if (act_select < 1) \{act_select += 1;\}
\par 
\par \b Key Press Event for <Down> Key:
\par \b0 execute code:
\par 
\par if (zone_select < 2) \{zone_select += 1;\}
\par ______________________________________________________
