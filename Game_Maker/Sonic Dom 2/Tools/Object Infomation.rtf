\par \b\fs24 Information about object: object_Woden_Block
\par \b0\fs16 
\par Sprite: sprite_woden_block
\par Solid: false
\par Visible: true
\par Depth: 0
\par Persistent: false
\par Parent: <no parent>
\par Mask: <same as sprite>
\par 
\par \b Create Event:
\par \b0 execute code:
\par 
\par switch (block_id) \{
\par     case 0: // left
\par         left_x = xstart;
\par         left_y = ystart;
\par         break;
\par     case 1: // middle
\par         left_x = xstart - sprite_width;
\par         left_y = ystart + sprite_height;
\par         break;
\par     case 2: // right
\par         left_x = xstart - (sprite_width * 2);
\par         left_y = ystart;
\par         break;
\par \}
\par 
\par var i;
\par for (i = 0; i < sprite_width / 32; i += 1) \{
\par     platforms[i] = instance_create(x + (i * 32), y, object_Platform);
\par     tops[i] = instance_create(x + (i * 32), y + sprite_height, object_Top);
\par \}
\par for (i = 0; i < sprite_height / 32; i += 1) \{
\par     walls_left[i] = instance_create(x, y + (i * 32), object_Wall);
\par     walls_right[i] = instance_create(x + sprite_width, y + (i * 32), object_Wall);
\par \}
\par 
\par \b  Step Event:
\par \b0 execute code:
\par 
\par var x_move y_move;
\par 
\par if (x == left_x && y > left_y - sprite_height) \{
\par     y_move = -4;
\par \} else if (x < left_x + (sprite_width * 2) && y == left_y - sprite_height) \{
\par     x_move = 4;
\par \} else if (x == left_x + (sprite_width * 2) && y < left_y) \{
\par     y_move = 4;
\par \} else if (x > left_x && y == left_y) \{
\par     x_move = -4;
\par \}
\par 
\par x += x_move;
\par y += y_move;
\par 
\par var i;
\par for (i = 0; i < sprite_width / 32; i += 1) \{
\par     with (platforms[i]) \{x += x_move; y += y_move;\}
\par     with (tops[i]) \{x += x_move; y += y_move;\}
\par \}
\par for (i = 0; i < sprite_height / 32; i += 1) \{
\par     with (walls_left[i]) \{x += x_move; y += y_move;\}
\par     with (walls_right[i]) \{x += x_move; y += y_move;\}
\par \}
\par 
\par \b End Step Event:
\par \b0 execute code:
\par 
\par var x_move y_move;
\par x_move = x - last_x;
\par y_move = y - last_y;
\par 
\par last_x = x;
\par last_y = y;
\par 
\par for (i = 0; i < sprite_height / 32; i += 1) \{
\par     with (walls_left[i]) \{
\par         if (place_meeting(x, y, object_Sonic)) \{
\par             object_Sonic.x += x_move;
\par             exit;
\par         \}
\par     \}
\par     with (walls_right[i]) \{
\par         if (place_meeting(x, y, object_Sonic)) \{
\par             with (object_Sonic) \{
\par                 if (place_meeting(x, y, object_Block_Crush_Detect)) \{script_die();\}
\par             \}
\par             object_Sonic.x += x_move;
\par             exit;
\par         \}
\par     \}
\par \}
\par 
\par for (i = 0; i < sprite_width / 32; i += 1) \{
\par     with (platforms[i]) \{
\par         if (place_meeting(x, y - 8, object_Sonic)) \{
\par             with (object_Sonic) \{
\par                 if (!place_meeting(x, y, object_Wall)) \{
\par                     x += x_move;
\par                     y += y_move;
\par                 \}
\par             \}
\par             exit;
\par         \}
\par     \}
\par     with (tops[i]) \{
\par         if (place_meeting(x, y, object_Sonic) && y_move > 0) \{
\par             with (object_Sonic) \{script_die();\}
\par             exit;
\par         \}
\par     \}
\par \}
\par ______________________________________________________
